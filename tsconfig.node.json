{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/node.tsbuildinfo"
  },
  "include": ["server", "shared", "vite.config.ts", "tests"]
}
